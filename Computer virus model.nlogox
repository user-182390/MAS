<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; specify different turtle breeds
breed [ clients client]
breed [ servers server]
breed [ routers router]
breed [ packages package]

globals [infection-chance]

turtles-own
[
  patient-zero?
  infected?
]

packages-own
[
  destination
  finish
  visited
]


to setup
  ;; reset values and call all initial functions
  clear-all
  reset-ticks
  random-seed seed
  setup-turtles
  setup-network
  start-infection
  calculate-infection-chance
end

to setup-turtles
  ;; create n instances of turtle breeds as specified by the user
  ask n-of n-clients patches with [not any? turtles-here and not any? turtles-on neighbors]
  [
    sprout-clients 1
    [
      set shape "computer workstation"
      set size 1.5
      set color white
      set patient-zero? False
      set infected? False
    ]
  ]
  ;; create n instances of turtle breeds as specified by the user
  ask n-of n-servers patches with [not any? turtles-here and not any? turtles-on neighbors]
  [
    sprout-servers 1
    [
      set shape "computer server"
      set size 1.5
      set color white
      set patient-zero? False
      set infected? False
    ]
  ]
  ;; create n instances of turtle breeds as specified by the user
  ask n-of n-routers patches with [not any? turtles-here and not any? turtles-on neighbors]
  [
    sprout-routers 1
    [
      set shape "circle"
      set size 1
      set color white
      set patient-zero? False
      set infected? False
    ]
  ]
end

to setup-network
  ask clients
  [
    ;; connect each client to closest router
    let target min-one-of routers [distance myself]
    ;; verify that target exists (might become redundant depending on range of n-routers)
    if target != nobody
    [
      create-link-with target
    ]
  ]
  
  ask servers
  [
    ;; connect each server to closest router
    let target min-one-of routers [distance myself]
    ;; verify that target exists (might become redundant depending on range of n-routers)
    if target != nobody
    [
      create-link-with target
    ]
  ]
  ask routers
  [
    ;; connect each router to closest unconnected router
    let target min-n-of 2 other routers with [not link-neighbor? myself] [distance myself]
    ;; verify that target exists
    if target != nobody
    [
     create-links-with target
    ]
  ]
end

to start-infection
  ;; infect 1 device at random. maybe make start with servers/routers possible as well? 
  ask one-of (turtle-set clients servers)
  [
    set patient-zero? True
    set infected? True
    set color red
  ]
end

to go
  if not any? packages
  [
    create-package
  ]
  ask packages
  [
    check-finish
    move-package 
  ]
  tick
end

to reset
  ask packages
  [
    die
  ]
  ask turtles
  [
    if patient-zero?
    [
      set infected? True
      set color red
    ]
    if not patient-zero?
    [
      set infected? False
      set color white
    ]
  ]
  clear-all-plots
  reset-ticks
end

to create-package
  let origin one-of (turtle-set clients servers)
  ask origin
  [
    ask patch-here
    [
      sprout-packages 1
      [
        set shape "letter sealed"
        set size 1.5
        set color [color] of origin
        set infected? [infected?] of origin
        set finish one-of other (turtle-set clients servers)
        set destination one-of ([link-neighbors] of origin) with [breed = routers]
        face destination
        set visited (turtle-set)
      ]
    ] 
  ]
end

to check-finish
  if patch-here = [patch-here] of finish
  [
    if infected?
    [
      infect
    ]
    die
  ]
end

to move-package
  if patch-here != [patch-here] of destination
  [
    fd 1
  ]
  if patch-here = [patch-here] of destination
  [
    let my-visited visited
    let my-finish finish
    if [link-neighbor? my-finish] of destination
    [
      set destination my-finish
    ]
    if destination != my-finish
    [
      set visited (turtle-set visited destination)
      let options ([link-neighbors] of destination) with [breed = routers and not member? self my-visited]
      if any? options
      [
        set destination min-one-of options [distance my-finish]
      ]
      if not any? options
      [
        set visited (turtle-set)
      ]
    ]
    face destination
  ]
end

to calculate-infection-chance
  let user-age-factor 0
  (ifelse
    user-age = "Young" [ set user-age-factor 2 ]
    user-age = "Middle" [ set user-age-factor 0 ]
    user-age = "Old" [ set user-age-factor 1 ]
  )
  
  let digital-security-awareness-factor 0
  
  let risk-aversion-factor 0
  (ifelse
    risk-aversion = "Very low" [ set risk-aversion-factor 2 ] 
    risk-aversion = "Low" [ set risk-aversion-factor 1 ] 
    risk-aversion = "Medium" [ set risk-aversion-factor 0 ] 
    risk-aversion = "High" [ set risk-aversion-factor -1 ] 
    risk-aversion = "Very high" [ set risk-aversion-factor -2 ]
  )
    
  let time-online-factor 0
  (ifelse 
    time-online = "Low" [ set time-online-factor 0]
    time-online = "Medium" [ set time-online-factor 1]
    time-online = "High" [ set time-online-factor 2]
  )
  
  let untrustworthy-usage-factor 0
  (ifelse 
    untrustworthy-usage = "Very low" [ set untrustworthy-usage-factor -2 ]
    untrustworthy-usage = "Low" [ set untrustworthy-usage-factor -1 ]
    untrustworthy-usage = "Medium" [ set untrustworthy-usage-factor 0 ]
    untrustworthy-usage = "High" [ set untrustworthy-usage-factor 1 ]
    untrustworthy-usage = "Very high" [ set untrustworthy-usage-factor 2 ]
  )

  let score ((user-age-weight * user-age-factor) + (time-online-weight * time-online-factor) + (untrustworthy-usage-weight * untrustworthy-usage-factor))
  let max-score ((user-age-weight + time-online-weight + untrustworthy-usage-weight) * 2)
  set infection-chance max (list (base-infection-rate * (score / max-score)) 0)
end

to infect
  if (random-float 1 < infection-chance)
  [
    ask finish
    [
      set color red
      set infected? True
    ]
  ]
end
  
  

]]></code>
